<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>InterfaceGenerator</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>lucaslgt.InterfaceGenerator</PackageId>
    <Version>$(InterfaceGeneratorVersion)</Version>
    <Authors>Lucas Lenglet</Authors>
    <Description>Generate an interface from a class, and have the class implement it, with a single attribute.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT-0</PackageLicenseExpression>
    <!-- The release workflow points ReleaseNotesFile (as an environment variable, which MSBuild
         reads as a property) at the CHANGELOG.md section of the version being published. -->
    <PackageReleaseNotes Condition="'$(ReleaseNotesFile)' != '' And Exists('$(ReleaseNotesFile)')">$([System.IO.File]::ReadAllText('$(ReleaseNotesFile)'))</PackageReleaseNotes>
    <PackageTags>interface;source-generator;roslyn;analyzer;dependency-injection;mocking</PackageTags>
    <PackageProjectUrl>https://github.com/lucaslenglet/InterfaceGenerator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lucaslenglet/InterfaceGenerator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Built as part of this project's build, but never referenced: the generator ships as an
      analyzer, not as an API. OutputItemType puts its path in @(Analyzer) for the pack target.
    -->
    <ProjectReference Include="..\InterfaceGenerator.Generator\InterfaceGenerator.Generator.csproj"
                      OutputItemType="Analyzer"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Places the generator under analyzers/dotnet/cs so Roslyn loads it, while this project's own
    assembly (the attributes) goes to lib/ as a normal reference. One package, two roles.
    @(Analyzer) also holds the SDK's own analyzers, hence the filter.
  -->
  <Target Name="PackGeneratorAsAnalyzer"
          BeforeTargets="_GetPackageFiles"
          DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <None Include="@(Analyzer)"
            Condition="'%(Filename)' == 'InterfaceGenerator.Generator'"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>

</Project>
