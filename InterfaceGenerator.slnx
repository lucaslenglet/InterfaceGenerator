  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/InterfaceGenerator.Tests/InterfaceGenerator.Tests.csproj" />
  </Folder>
  <!-- Consumed through the local NuGet feed that run.ps1 builds, so not solution projects. -->
  <Folder Name="/tests/Packaging/">
    <File Path="tests/Packaging/NuGet.config" />
    <File Path="tests/Packaging/run.ps1" />
  </Folder>
</Solution>
