<Solution>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path=".gitignore" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Build.targets" />
    <File Path="Directory.Packages.props" />
    <File Path="global.json" />
    <File Path="README.md" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/InterfaceGenerator.Abstractions/InterfaceGenerator.Abstractions.csproj" />
    <Project Path="src/InterfaceGenerator.Generator/InterfaceGenerator.Generator.csproj" />
  </Folder>
  <Folder Name="/samples/">
